{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/whitepaper", "destination": "/research/whitepaper", "permanent": true },
    { "source": "/validation", "destination": "/research/validation", "permanent": true },
    { "source": "/protocol", "destination": "/research/protocol", "permanent": true },
    { "source": "/systems", "destination": "/research/systems", "permanent": true },
    { "source": "/about", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/for-agents",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/(markdown|plain).*" }],
      "destination": "/agents.md"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/llms(-full)?\\.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/for-agents",
      "headers": [{ "key": "Vary", "value": "Accept" }]
    }
  ]
}
